graph TD
    subgraph Data Layer
        A[Raw Sales Data Online Retail.xlsx] --> B[Data Preprocessing & Feature Engineering]
        B -->|Cleaned Time-Series Data Lags, Moving Averages| C
    end

    subgraph The Predictive Brain
        C[XGBoost Regressor Forecast Model]
    end

    subgraph The Decision Brain
        B --> D[Inventory Simulation Env]
        C -->|7-Day Ahead Forecast| D
        D -->|State: Current Stock, Forecast| E(Deep Q-Network RL Agent)
        E -->|Action: Reorder Quantity| D
        E -->|Learned Reorder Policy| F
    end

    subgraph The Application Layer
        F[FastAPI Backend app.py / api.py]
        F -->|Real-Time Inventory State & Recommended Reorders| G[Streamlit Dashboard dashboard.py]
    end

    classDef predictive fill:#e1f5fe,stroke:#03a9f4,stroke-width:2px;
    classDef decision fill:#e8f5e9,stroke:#4caf50,stroke-width:2px;
    classDef app fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px;
    class C predictive;
    class E decision;
    class F,G app;
